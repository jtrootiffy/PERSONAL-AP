# --- App --------------------------------------------------------------------
# Public base URL of the app (used for links in emails / server actions)
NEXT_PUBLIC_APP_URL="trootiffyap.vercel.app"

# One-time secret that gates the /setup page used to create the FIRST admin.
# Generate one with:  node -e "console.log(crypto.randomUUID())"
# Leave blank to disable the /setup route entirely (recommended once set up).
SETUP_TOKEN=""

# --- Optional: email notifications (disabled unless fully configured) -------
# In-app notifications always work. Email is opt-in and requires ALL of these.
# Leave blank to keep email disabled (password reset links are logged to the
# server console in development instead of being emailed).
RESEND_API_KEY=""
EMAIL_FROM=""
SMTP_HOST=""
SMTP_PORT=""
SMTP_USER=""
SMTP_PASSWORD=""
